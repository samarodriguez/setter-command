# Get a key at https://console.anthropic.com — powers the Train simulator & pattern analysis
ANTHROPIC_API_KEY=sk-ant-...

# Optional: real property records (owner, year built, sale history, rentals)
# Free tier = 50 lookups/mo. Get a key at https://app.rentcast.io/app/api
RENTCAST_API_KEY=

# Optional: auto-pull company appointments from a Slack channel
# Create a bot at api.slack.com/apps, add channels:history scope, invite it to the channel
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
